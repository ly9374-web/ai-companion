{
  "id": "camera",
  "version": 23,
  "backend_entry": "backend_context.py",
  "backend_required_hooks": [
    "registration_features",
    "public_account_features",
    "account_policy",
    "account_can_access_character",
    "process_text_input",
    "new_history_messages",
    "after_character_switch",
    "augment_tool_status",
    "build_request_context",
    "collect_analysis_data"
  ],
  "frontend_entry": "frontend/index.js",
  "frontend_source_entry": "frontend-src/index.tsx",
  "electron_main_entry": "frontend-src/main.ts",
  "electron_mac_usage_descriptions": {
    "NSCameraUsageDescription": "Application requests access to the device's camera."
  },
  "config": {
    "server_url": "ws://127.0.0.1:8765/ws",
    "fps": 12,
    "jpeg_quality": 0.78,
    "max_result_age_ms": 2500,
    "max_buffered_bytes": 65536
  },
  "static_mounts": [
    {
      "route": "/web-tool",
      "directory": "web_tool",
      "html": true
    }
  ]
}
